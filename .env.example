# ── Network ──────────────────────────────────────────────────────────────
# v1 supports BNB Testnet ONLY. The bot fails closed if the connected
# chain ID does not match CHAIN_ID.
NETWORK=bsc-testnet
CHAIN_ID=97

# Public BSC testnet RPC used as a fallback if left blank:
# https://bsc-dataseed.bnbchain.org
RPC_URL=

# ── Wallet(s) ────────────────────────────────────────────────────────────
# NEVER commit real private keys. 0x-prefixed 64 hex chars.
# One wallet, or comma-separated for multiple (each trades independently,
# on its own random schedule, with its own circuit breaker — §29).
#   PRIVATE_KEY=0xaaa...,0xbbb...,0xccc...
PRIVATE_KEY=

# ── Flap (BNB Testnet) ──────────────────────────────────────────────────
# Portal address sourced from https://docs.flap.sh/flap/developers/deployed-contract-addresses
# (fetched 2026-08-24, testnet Portal v5.8.5). Re-verify before relying on it.
FLAP_PORTAL_ADDRESS=0x5bEacaF7ABCbB3aB280e80D007FD31fcE26510e9
# The token you want the bot to trade (works for either TRADING_MODE — the
# name is historical). TOKEN_ADDRESS is accepted as an alias. No default.
FLAP_TOKEN_ADDRESS=

# ── PancakeSwap (BSC Testnet) ───────────────────────────────────────────
# Commonly referenced community/testing PancakeSwap V2 Router02 deployment
# on BSC Testnet. PancakeSwap has no official testnet product — re-verify
# on testnet.bscscan.com before trusting it with funds.
PANCAKE_ROUTER_ADDRESS=0xD99D1c33F9fC3444f8101754aBC46c52416550D1

# ── Trading mode ─────────────────────────────────────────────────────────
# flap | pancake
TRADING_MODE=flap

# ── Timing ───────────────────────────────────────────────────────────────
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=300

# ── Buy amounts (BNB) ────────────────────────────────────────────────────
MIN_BUY_BNB=0.001
MAX_BUY_BNB=0.01

# ── Sell amounts (% of token balance) ───────────────────────────────────
MIN_SELL_PERCENT=10
MAX_SELL_PERCENT=40

# ── Action weighting ─────────────────────────────────────────────────────
BUY_WEIGHT=50
SELL_WEIGHT=50

# ── Slippage ─────────────────────────────────────────────────────────────
SLIPPAGE_BPS=300

# ── Gas safety ───────────────────────────────────────────────────────────
GAS_RESERVE_BNB=0.01
MIN_BNB_BALANCE=0.015
MAX_GAS_PRICE_GWEI=
MAX_GAS_COST_BNB=

# ── Operational limits ───────────────────────────────────────────────────
# 0 = unlimited
MAX_TRADE_COUNT=0
MAX_SINGLE_TRADE_BNB=0.01
MAX_DAILY_BNB_VOLUME=0.1

# ── Gas bank (multi-wallet groundwork, disabled in v1) ──────────────────
AUTO_GAS_REFILL=false
GAS_BANK_PRIVATE_KEY=

# ── Safety ───────────────────────────────────────────────────────────────
# Must stay true until you deliberately run a real testnet trade.
DRY_RUN=true
